# ESPN credentials — three ways to set these:
#   1. Browser login:  uv run espn auth login  (easiest, auto-captures cookies)
#   2. Manual token:   uv run espn auth token <ESPN_S2> <ESPN_SWID>
#   3. Edit this file: fill in values below, then copy to .env
ESPN_S2=your_espn_s2_cookie_here
ESPN_SWID={your_swid_here}

# League configuration
ESPN_LEAGUE_ID=612122596
ESPN_YEAR=2026
# Optional: highest-priority resolver for "my team" tools
ESPN_TEAM_ID=
# Fallback: normalized exact name, then partial team/owner match
ESPN_TEAM_NAME=Gabriel

# Transport: stdio (local/Claude Code), sse (remote/Railway), streamable-http
MCP_TRANSPORT=stdio
